<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/cream_bg"
    android:padding="24dp">

    <TextView
        android:id="@+id/submitAssignmentTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Submit Assignment"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/maroon_primary"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pickFileButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Choose File"
        android:textAllCaps="false"
        android:textColor="@color/maroon_primary"
        app:cornerRadius="24dp"
        app:strokeColor="@color/maroon_primary"
        app:strokeWidth="1dp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:id="@+id/selectedFileNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No file selected"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/submitFileButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Submit"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        app:backgroundTint="@color/maroon_primary"
        app:cornerRadius="24dp"
        android:enabled="false" />

    <ProgressBar
        android:id="@+id/submitProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

</LinearLayout>