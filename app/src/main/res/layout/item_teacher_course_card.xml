<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/cream_card_bg"
    android:elevation="2dp"
    android:padding="18dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:id="@+id/teacherCourseTagText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/badge_pill_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textColor="@color/maroon_primary"
        android:textStyle="bold"
        android:textSize="11sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        android:text="TAG" />

    <TextView
        android:id="@+id/teacherCourseNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="#000000"
        android:text="Course Name" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_admin_users"
            app:tint="@color/text_muted" />

        <TextView
            android:id="@+id/teacherCourseStudentCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_muted"
            android:layout_marginStart="6dp"
            android:text="0 students enrolled" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/openCourseButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:background="@drawable/maroon_pill_button"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>