<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/cream_card_bg"
    android:elevation="2dp"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/teacherAssignmentTitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="#000000"
        android:text="Assignment title" />

    <TextView
        android:id="@+id/teacherAssignmentDescText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#3E2E2E"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        android:text="Description" />

    <TextView
        android:id="@+id/teacherAssignmentDueText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/text_muted"
        android:layout_marginTop="4dp"
        android:text="Due date" />

    <TextView
        android:id="@+id/teacherAssignmentSubmissionsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#4A7C59"
        android:layout_marginTop="4dp"
        android:text="0 submissions" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/viewSubmissionsButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="View Submissions"
        android:textAllCaps="false"
        android:textColor="@color/maroon_primary"
        android:textStyle="bold" />

</LinearLayout>