<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assignments"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/maroon_primary"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/cream_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assignment Title"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted" />

                <EditText
                    android:id="@+id/assignmentTitleInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:padding="0dp"
                    android:textSize="16sp"
                    android:textColor="#000000" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/cream_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description (optional)"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted" />

                <EditText
                    android:id="@+id/assignmentDescriptionInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:padding="0dp"
                    android:minLines="3"
                    android:gravity="top"
                    android:textSize="14sp"
                    android:textColor="#000000" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pickDueDateButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Pick Due Date"
                android:textAllCaps="false"
                android:textColor="@color/maroon_primary"
                app:cornerRadius="24dp"
                app:strokeColor="@color/maroon_primary"
                app:strokeWidth="1dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/selectedDueDateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No due date selected"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/postAssignmentButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Post Assignment"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="@color/maroon_primary"
                app:cornerRadius="24dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Posted Assignments"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/maroon_primary"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/assignmentsListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>