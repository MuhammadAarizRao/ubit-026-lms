<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/cream_card_bg"
    android:elevation="2dp"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/userRowName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="#000000"
        android:text="Name" />

    <TextView
        android:id="@+id/userRowIdRole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/text_muted"
        android:layout_marginTop="4dp"
        android:text="ID · Role" />

    <TextView
        android:id="@+id/userRowMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/maroon_primary"
        android:layout_marginTop="2dp"
        android:text="Section · Semester · Batch" />

</LinearLayout>